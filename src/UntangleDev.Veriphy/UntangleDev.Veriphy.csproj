<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UntangleDev.Veriphy</RootNamespace>
    <AssemblyName>UntangleDev.Veriphy</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>UntangleDev.Veriphy</PackageId>
    <Version>1.1.0</Version>
    <Authors>UntangleDev</Authors>
    <Company>UntangleDev</Company>
    <Description>An unofficial, unaffiliated C#/.NET SDK for the Veriphy BankWizard and IDAML API surfaces. This package is not official, sponsored, or endorsed by Veriphy.</Description>
    <PackageTags>veriphy;bankwizard;idaml;aml;kyc;bank-verification</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/UntangleDev/Veriphy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UntangleDev/Veriphy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Add idiomatic BankWizard and IDAML request models while preserving generated DTO overloads. This is an unofficial, unaffiliated client and is not endorsed by Veriphy.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
